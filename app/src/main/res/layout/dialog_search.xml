<?xml version="1.0" encoding="utf-8"?>
<!-- The search modal: a glass panel over the dimmed home screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8080810">

    <LinearLayout
        android:id="@+id/search_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="168dp"
        android:layout_marginEnd="168dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_search_panel"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/search_sparkle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sparkle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/search_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Search"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/search_kid_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_kids_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="4dp"
                android:text="Kid-friendly answers"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/search_clear"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_app_tile"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Clear chat"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The conversation -->
        <ScrollView
            android:id="@+id/search_chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/search_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
        <TextView
            android:id="@+id/search_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#A9A3FF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Matching apps -->
        <TextView
            android:id="@+id/search_apps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Apps"
            android:textColor="#9A9AB5"
            android:textSize="14sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/search_apps_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_apps_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Send to the AI -->
        <TextView
            android:id="@+id/search_ask"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_app_tile"
            android:drawableStart="@drawable/ic_sparkle"
            android:drawablePadding="12dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Search box and mic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:hint="Search apps or ask a question"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="#8A8AA5"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/search_stop_speaking"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_app_tile"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Stop talking"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/search_mic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="Voice input"
                android:focusable="true"
                android:padding="15dp"
                android:src="@drawable/ic_mic"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
