<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background dim so the picker stands out -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F0F1A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Who's watching?"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <!-- Subtitle / hint when no profiles exist -->
        <TextView
            android:id="@+id/tv_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create a profile to get started"
            android:textSize="18sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Profile grid (adapter appends a trailing "Add New" tile) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="16dp" />

        <!-- How to reach rename/delete -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold OK on a profile to rename or delete it"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</FrameLayout>
