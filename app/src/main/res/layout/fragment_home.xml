<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 0a: Video background -->
    <TextureView
        android:id="@+id/bg_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />




    <!-- Layer 1: Dim overlay (makes video darker for readability) -->
    <View
        android:id="@+id/bg_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.5" />

    <!-- Layer 2: UI content -->
    <LinearLayout
        android:id="@+id/home_content"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Left: Time + Weather -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Dark panel behind the time and weather -->
                <LinearLayout
                    android:id="@+id/panel_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:focusable="true"
                    android:contentDescription="Weather"
                    android:background="@drawable/bg_header_panel_focusable"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/weather_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:layout_marginTop="4dp">

                    <!-- Layered weather icon: celestial body + weather overlay -->
                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/iv_celestial"
                            android:layout_width="32dp"
                            android:layout_height="32dp" />

                        <ImageView
                            android:id="@+id/iv_weather_overlay"
                            android:layout_width="32dp"
                            android:layout_height="32dp" />
                    </FrameLayout>

                    <ProgressBar
                        android:id="@+id/weather_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="140dp"
                        android:layout_height="4dp"
                        android:scaleY="3"
                        android:layout_marginEnd="8dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/text_primary"
                        android:indeterminateTintMode="src_in"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <ImageView
                        android:id="@+id/iv_wind_arrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_wind_arrow" />

                    <TextView
                        android:id="@+id/tv_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="18sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/btn_weather_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Retry"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_app_tile"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- A weather alert, when there is one: coloured by how serious it is -->
                <TextView
                    android:id="@+id/tv_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:visibility="gone" />

                <!-- Kid profiles with a time limit or bedtime: time left today, or why apps are off -->
                <TextView
                    android:id="@+id/tv_time_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: profile, search and settings on one dark panel -->
            <LinearLayout
                android:id="@+id/panel_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header_panel"
                android:padding="8dp">

            <!-- Shown only when a newer version of Portal has been found; it opens Settings at the update. -->
            <LinearLayout
                android:id="@+id/btn_update"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_app_tile"
                android:contentDescription="Update available"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_update"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Update"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:textColor="#7DE3FF"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Buttons and text that allowed extensions add; empty and hidden otherwise -->
            <LinearLayout
                android:id="@+id/ext_bar_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btn_profile"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:background="@drawable/bg_app_tile"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="Profile" />

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text=""
                    android:textSize="16sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_search"
                android:background="@drawable/bg_app_tile"
                android:focusable="true"
                android:contentDescription="Search" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_app_tile"
                android:focusable="true"
                android:contentDescription="Settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons and text that allowed extensions add under the time and weather; empty and hidden otherwise.
             Outside the header so it doesn't change how the header lines up. -->
        <LinearLayout
            android:id="@+id/ext_clock_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header_panel"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- The app lists scroll together under the fixed header -->
        <androidx.core.widget.NestedScrollView
            android:clipChildren="false"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- Frequently Used -->
        <TextView
            android:id="@+id/tv_frequent_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequently Used"
            android:textSize="20sp"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:background="@drawable/bg_section_label"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/frequent_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <!-- All Apps -->
        <TextView
            android:id="@+id/tv_all_apps_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Apps"
            android:textSize="20sp"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:background="@drawable/bg_section_label"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Layer 2b: a severe weather alert, in red across the top while one is active -->
    <LinearLayout
        android:id="@+id/severe_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_severe_alert"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:minWidth="250dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/severe_title"
            android:maxWidth="300dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/severe_detail"
            android:maxWidth="300dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:textColor="#FFFFFFDD" />
    </LinearLayout>

    <!-- Layer 3: birthday greeting, only shown on someone's birthday -->
    <TextView
        android:id="@+id/tv_birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_header_panel"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:maxWidth="400dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <!-- Layer 4: a kid's bedtime or time limit. Covers everything, video included. -->
    <include layout="@layout/include_kid_lock" />

</FrameLayout>
