<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search/Manage Videos"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vb_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/vb_key_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textSize="15sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/vb_key_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textSize="16sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_settings_tile"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vb_search_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/vb_query"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="Search for videos, such as aurora, fireplace or ocean"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/vb_search"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Search"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_settings_tile"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/vb_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vb_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/vb_credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Shown while a video downloads -->
    <FrameLayout
        android:id="@+id/vb_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20F0F1A"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_header_panel"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/vb_progress_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_primary"
                android:maxLines="2" />

            <ProgressBar
                android:id="@+id/vb_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:max="1000" />

            <TextView
                android:id="@+id/vb_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/vb_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Cancel"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_settings_tile"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
