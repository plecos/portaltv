<?xml version="1.0" encoding="utf-8"?>
<!-- The parent unlock button: a round frosted button that glows when it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#2EFFFFFF" />
                    <stroke android:width="3dp" android:color="#F2FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1.5dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
