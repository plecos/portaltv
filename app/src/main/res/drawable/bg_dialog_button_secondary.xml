<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog button: filled, with a lighter fill and a white ring while it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DFFFFFF" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="3dp" android:color="#00FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
