<?xml version="1.0" encoding="utf-8"?>
<!-- The parent unlock button on the daytime scene: dark enough to read on a light sky, and glowing when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#FF3949AB" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E65C6BC0" />
            <stroke android:width="1.5dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</selector>
