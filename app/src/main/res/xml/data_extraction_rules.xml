<?xml version="1.0" encoding="utf-8"?>
<!-- Keep Portal's adb key out of backups and device-to-device transfers: it lets Portal talk to this TV's own debug service. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
    </device-transfer>
</data-extraction-rules>
