<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Behind everything: a drawn scene for the weather -->
    <net.getportaltv.weather.page.WeatherEffectView
        android:id="@+id/weather_bg_effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/weather_bg_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.35"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp">


    <TextView
        android:id="@+id/weather_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weather"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/weather_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/weather_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading…"
        android:textSize="20sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/weather_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Retry"
        android:textSize="18sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_app_tile"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:focusable="true"
        android:visibility="gone" />

    <!-- D-pad up/down scrolls the page -->
    <ScrollView
        android:id="@+id/weather_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Active alerts from the National Weather Service (US only) -->
            <LinearLayout
                android:id="@+id/weather_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Right now -->
            <LinearLayout
                android:id="@+id/weather_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header_panel"
                android:padding="28dp">

                <FrameLayout
                    android:id="@+id/weather_current_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="28dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="72sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/weather_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_detail_feels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/weather_detail_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/weather_detail_wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/weather_detail_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Next 12 hours -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Next 12 hours"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_panel"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/weather_hourly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp" />
            </HorizontalScrollView>

            <!-- Rain radar -->
            <LinearLayout
                android:id="@+id/weather_radar_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Radar"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_header_panel"
                    android:padding="12dp">

                    <net.getportaltv.weather.page.RadarView
                        android:id="@+id/weather_radar"
                        android:layout_width="0dp"
                        android:layout_height="340dp"
                        android:layout_weight="1" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:columnCount="2">

                        <ImageView
                            android:id="@+id/radar_zoom_in"
                            style="@style/RadarButton"
                            android:contentDescription="Zoom in"
                            android:src="@drawable/ic_zoom_in" />

                        <ImageView
                            android:id="@+id/radar_zoom_out"
                            style="@style/RadarButton"
                            android:contentDescription="Zoom out"
                            android:src="@drawable/ic_zoom_out" />

                        <ImageView
                            android:id="@+id/radar_play"
                            style="@style/RadarButton"
                            android:contentDescription="Pause or play"
                            android:src="@drawable/ic_pause" />

                        <ImageView
                            android:id="@+id/radar_layers"
                            style="@style/RadarButton"
                            android:contentDescription="Change map"
                            android:src="@drawable/ic_layers" />

                        <ImageView
                            android:id="@+id/radar_move"
                            style="@style/RadarButton"
                            android:contentDescription="Move the map"
                            android:src="@drawable/ic_move" />

                        <ImageView
                            android:id="@+id/radar_pin"
                            style="@style/RadarButton"
                            android:contentDescription="Use this spot as my location"
                            android:src="@drawable/ic_pin" />

                        <ImageView
                            android:id="@+id/radar_fullscreen"
                            style="@style/RadarButton"
                            android:contentDescription="Full screen"
                            android:src="@drawable/ic_fullscreen" />
                    </GridLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Next 7 days -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="7-day forecast"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/weather_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_panel"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Details"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/weather_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_panel"
                android:padding="16dp" />

            <!-- Moon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Moon"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/weather_moon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_header_panel"
                android:padding="24dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
