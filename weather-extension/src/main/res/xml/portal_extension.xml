<?xml version="1.0" encoding="utf-8"?>
<!-- Describes this extension to Portal. See docs/EXTENSIONS.md in the Portal repository. -->
<portal-extension
    contract="1"
    id="weather"
    label="@string/ext_name"
    description="@string/ext_description">

    <!-- Where Portal gets its weather, alerts, city search and radar: Open-Meteo, the US National Weather Service and RainViewer. -->
    <weather-source service=".WeatherService" />

    <!-- The weather page that opens from the home screen. It asks Portal for everything it shows. -->
    <weather-page activity=".page.WeatherPageActivity" />
</portal-extension>
