<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No launcher entry and no screens: this app only answers Portal when Portal asks for the weather. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_weather"
        android:supportsRtl="true">

        <!-- This is what makes the app a Portal extension: it points at the file that describes it. -->
        <meta-data
            android:name="net.getportaltv.extension"
            android:resource="@xml/portal_extension" />

        <!-- Portal binds to this to ask for the weather; it must be exported. -->
        <service android:name=".WeatherService" android:exported="true">
            <intent-filter>
                <action android:name="net.getportaltv.WEATHER_SOURCE" />
            </intent-filter>
        </service>
    </application>

</manifest>
