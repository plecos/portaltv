<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11 and later hide other apps' providers unless asked for: this is what lets the weather page call Portal. -->
    <queries>
        <provider android:authorities="net.getportaltv.host" />
    </queries>

    <!-- No launcher entry: this app only shows up in Portal, as the weather source and the weather page. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_weather"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- This is what makes the app a Portal extension: it points at the file that describes it. -->
        <meta-data
            android:name="net.getportaltv.extension"
            android:resource="@xml/portal_extension" />

        <!-- Portal opens this when the time and weather panel is pressed; it must be exported. -->
        <activity android:name=".page.WeatherPageActivity" android:exported="true" />

        <!-- Portal binds to this to ask for the weather, the alerts, a city search and radar pictures; it must be exported. -->
        <service android:name=".WeatherService" android:exported="true">
            <intent-filter>
                <action android:name="net.getportaltv.WEATHER_SOURCE" />
            </intent-filter>
        </service>
    </application>

</manifest>
