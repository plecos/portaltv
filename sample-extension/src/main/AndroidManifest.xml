<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 and later hide other apps' providers unless asked for: this is what lets the sample call Portal. -->
    <queries>
        <provider android:authorities="net.getportaltv.host" />
    </queries>

    <!-- No launcher entry: this app only appears in Portal through the tiles it declares. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_sample"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- This is what makes the app a Portal extension: it points at the file that describes it. -->
        <meta-data
            android:name="net.getportaltv.extension"
            android:resource="@xml/portal_extension" />

        <!-- Screens Portal opens must be exported. -->
        <activity android:name=".LightsActivity" android:exported="true" />
        <activity android:name=".CamerasActivity" android:exported="true" />
        <activity android:name=".SettingsActivity" android:exported="true" />

        <!-- Portal binds to this to ask for a background; it must be exported. -->
        <service android:name=".BackgroundService" android:exported="true">
            <intent-filter>
                <action android:name="net.getportaltv.BACKGROUND" />
            </intent-filter>
        </service>
    </application>

</manifest>
