<?xml version="1.0" encoding="utf-8"?>
<portal-extension
    contract="1"
    id="scenic"
    label="@string/ext_name"
    description="@string/ext_description">

    <!-- Reads the weather, and roughly where the TV is, to match the sky. -->
    <uses capability="weather" />

    <settings activity=".SettingsActivity" />

    <!-- Draws the home screen background when chosen in Settings, Background. -->
    <background service=".ScenicService" />
</portal-extension>
