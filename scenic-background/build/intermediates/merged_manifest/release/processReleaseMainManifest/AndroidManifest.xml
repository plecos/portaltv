<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.getportaltv.scenic"
    android:versionCode="1"
    android:versionName="0.1" >

    <uses-sdk
        android:minSdkVersion="34"
        android:targetSdkVersion="37" />

    <!-- Lets this app call Portal's host provider (for the weather). -->
    <queries>
        <provider android:authorities="net.getportaltv.host" />
    </queries>

    <!-- No launcher entry: this app only appears in Portal as a background choice and a settings page. -->
    <application
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_scenic"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" >
        <meta-data
            android:name="net.getportaltv.extension"
            android:resource="@xml/portal_extension" />

        <activity
            android:name="net.getportaltv.scenic.SettingsActivity"
            android:exported="true" />

        <!-- Portal binds to this to ask for a background; it must be exported. -->
        <service
            android:name="net.getportaltv.scenic.ScenicService"
            android:exported="true" >
            <intent-filter>
                <action android:name="net.getportaltv.BACKGROUND" />
            </intent-filter>
        </service>
    </application>

</manifest>